<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console of its own: Windows starts it for every call, and that mustn't open a terminal. Program.cs makes one when a person runs it. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iphonecall</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The build output folder is registered as-is as a loose package (Developer Mode). -->
    <OutputPath>pkg\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Update="AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
